# Anthropic API key for cheat sheet generation (server-side only)
ANTHROPIC_API_KEY=

# Upstash Redis (optional) — enables rate limiting on /api/generate.
# Without these, the API runs unthrottled (fine for local dev).
# Provision via Vercel Marketplace → Upstash, or https://console.upstash.com
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
