{
  "title": "Vim Cheat Sheet",
  "sections": [
    {
      "title": "MODES & BASICS",
      "commands": [
        { "cmd": "i", "desc": "Enter insert mode before the cursor" },
        { "cmd": "a", "desc": "Enter insert mode after the cursor" },
        { "cmd": "I", "desc": "Insert at beginning of current line" },
        { "cmd": "A", "desc": "Insert at end of current line" },
        { "cmd": "v", "desc": "Enter visual character-wise mode" },
        { "cmd": "V", "desc": "Enter visual line-wise mode" },
        { "cmd": "Esc", "desc": "Return to normal mode from any mode" },
        { "cmd": ":help <topic>", "desc": "Open Vim help for a topic" }
      ]
    },
    {
      "title": "NAVIGATION",
      "commands": [
        { "cmd": "h j k l", "desc": "Move left, down, up, and right" },
        { "cmd": "w", "desc": "Jump to start of next word" },
        { "cmd": "b", "desc": "Jump to start of previous word" },
        { "cmd": "gg", "desc": "Go to first line of file" },
        { "cmd": "G", "desc": "Go to last line of file" },
        { "cmd": "0 / $", "desc": "Jump to start or end of line" },
        { "cmd": "Ctrl+d / Ctrl+u", "desc": "Scroll half page down or up" },
        { "cmd": ":%", "desc": "Jump to matching bracket or brace" }
      ]
    },
    {
      "title": "EDITING",
      "commands": [
        { "cmd": "dd", "desc": "Delete current line" },
        { "cmd": "yy", "desc": "Yank copy of current line" },
        { "cmd": "p", "desc": "Paste after cursor or below line" },
        { "cmd": "P", "desc": "Paste before cursor or above line" },
        { "cmd": "u", "desc": "Undo last change" },
        { "cmd": "Ctrl+r", "desc": "Redo undone change" },
        { "cmd": "x", "desc": "Delete character under cursor" },
        { "cmd": ".", "desc": "Repeat the last change" }
      ]
    },
    {
      "title": "SEARCH & REPLACE",
      "commands": [
        { "cmd": "/pattern", "desc": "Search forward for pattern" },
        { "cmd": "?pattern", "desc": "Search backward for pattern" },
        { "cmd": "n / N", "desc": "Go to next or previous match" },
        { "cmd": ":%s/old/new/g", "desc": "Replace all occurrences in file" },
        { "cmd": ":%s/old/new/gc", "desc": "Replace all with confirmation prompts" },
        { "cmd": ":*s/old/new/g", "desc": "Replace within the visual selection" },
        { "cmd": ":set ignorecase", "desc": "Make searches case-insensitive" },
        { "cmd": ":noh", "desc": "Clear search highlight until next search" }
      ]
    },
    {
      "title": "FILES & BUFFERS",
      "commands": [
        { "cmd": ":e <file>", "desc": "Open a file for editing" },
        { "cmd": ":w", "desc": "Write current buffer to disk" },
        { "cmd": ":wq", "desc": "Write buffer and quit Vim" },
        { "cmd": ":q", "desc": "Quit current buffer" },
        { "cmd": ":q!", "desc": "Quit without saving changes" },
        { "cmd": ":bn / :bp", "desc": "Go to next or previous buffer" },
        { "cmd": ":ls", "desc": "List open buffers" },
        { "cmd": ":sp <file>", "desc": "Open file in horizontal split" }
      ]
    },
    {
      "title": "ADVANCED",
      "commands": [
        { "cmd": ":set number", "desc": "Show line numbers in gutter" },
        { "cmd": ":set relativenumber", "desc": "Show relative line numbers" },
        { "cmd": ">> / <<", "desc": "Indent or outdent current line" },
        { "cmd": "vip", "desc": "Select inner paragraph in visual mode" },
        { "cmd": "ci\"", "desc": "Change text inside surrounding quotes" },
        { "cmd": ":marks", "desc": "List all set marks in buffer" },
        { "cmd": "ma / 'a", "desc": "Set mark a and jump back to it" },
        { "cmd": ":reg", "desc": "Show contents of all registers" }
      ]
    }
  ]
}
